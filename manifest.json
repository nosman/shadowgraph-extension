{
  "manifest_version": 3,
  "name": "Shadowgraph",
  "version": "0.1.0",
  "description": "Repos citing arXiv papers, and similar repos and discussions for GitHub repos, from Shadowgraph.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "options_page": "options.html",
  "permissions": ["storage"],
  "host_permissions": [
    "https://arxiv.org/*",
    "https://www.arxiv.org/*",
    "https://github.com/*",
    "https://shadowgraph.io/*",
    "http://localhost:3000/*"
  ]
}
