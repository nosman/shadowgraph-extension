{
  "manifest_version": 3,
  "name": "Shadowgraph: GitHub Repo Mentions on Hacker News, Reddit & X",
  "short_name": "Shadowgraph",
  "version": "0.3.0",
  "description": "Discover open source projects and see what people are saying about them across GitHub, Hugging Face and arXiv.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "Open Shadowgraph"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://arxiv.org/*",
    "https://www.arxiv.org/*",
    "https://github.com/*",
    "https://huggingface.co/*",
    "https://dl.acm.org/*",
    "https://shadowgraph.io/*",
    "http://localhost:3000/*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
